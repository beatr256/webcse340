<%- include("partials/header") %>

<section class="page-heading">
  <h1><%= title %></h1>

  <p>
    Explore service opportunities based on your interests.
  </p>
  <a href="/new-category" class="button">Create Category</a>
</section>

<section class="card-grid">
  <% categories.forEach((category) => { %>
    <article class="card">
      <h2><a href="/category/<%= category.category_id %>"><%= category.category_name %></a></h2>
      <a href="/edit-category/<%= category.category_id %>">Edit category</a>
    </article>
  <% }) %>

</section>

<%- include("partials/footer") %>