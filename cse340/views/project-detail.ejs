<%- include("partials/header") %>

<section class="page-heading">
  <h1><%= project.project_name %></h1>
  <p><%= project.project_description %></p>
  <% if (currentUser?.role === "admin") { %>
    <a href="/edit-project/<%= project.project_id %>" class="button">Edit Service Project</a>
  <% } %>
</section>

<% if (currentUser) { %>
  <section class="content-section volunteer-action-section">
    <% if (isVolunteering) { %>
      <p role="status">You are volunteering for this project.</p>
      <form action="/project/<%= project.project_id %>/unvolunteer" method="post">
        <button class="button button-secondary form-submit" type="submit">Remove me from this project</button>
      </form>
    <% } else { %>
      <form action="/project/<%= project.project_id %>/volunteer" method="post">
        <button class="button form-submit" type="submit">Volunteer for this project</button>
      </form>
    <% } %>
  </section>
<% } %>

<section class="content-section detail-layout">
  <div class="card">
    <p>Organization: <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
    <p>Location: <%= project.project_location %></p>
    <p>Date: <%= new Date(project.project_date).toLocaleDateString() %></p>
  </div>

  <div>
    <h2>Categories</h2>
    <div class="tag-list">
      <% categories.forEach((category) => { %>
        <a class="tag" href="/category/<%= category.category_id %>"><%= category.category_name %></a>
      <% }) %>
    </div>
  </div>
</section>

<%- include("partials/footer") %>
