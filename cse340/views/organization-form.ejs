<%- include("partials/header") %>

<section class="page-heading"><h1><%= heading %></h1></section>
<section class="form-section">
  <% if (errors.length) { %><div class="form-errors" role="alert"><ul><% errors.forEach((error) => { %><li><%= error %></li><% }) %></ul></div><% } %>
  <form class="form-card" action="<%= formAction %>" method="post">
    <label for="organization_name">Organization name</label>
    <input id="organization_name" name="organization_name" value="<%= organization.organization_name %>" maxlength="100" required>
    <label for="organization_description">Description</label>
    <textarea id="organization_description" name="organization_description" maxlength="255" required><%= organization.organization_description %></textarea>
    <label for="contact_email">Contact email</label>
    <input id="contact_email" name="contact_email" type="email" value="<%= organization.contact_email %>" maxlength="255" required>
    <label for="image_file">Image file name</label>
    <input id="image_file" name="image_file" value="<%= organization.image_file %>" maxlength="100" required>
    <button class="button" type="submit">Save organization</button>
    <a class="button button-secondary" href="/organizations">Cancel</a>
  </form>
</section>
<%- include("partials/footer") %>