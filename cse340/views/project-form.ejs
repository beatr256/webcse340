<%- include("partials/header") %>

<section class="page-heading"><h1><%= heading %></h1></section>
<section class="form-section">
  <% if (errors.length) { %><div class="form-errors" role="alert"><ul><% errors.forEach((error) => { %><li><%= error %></li><% }) %></ul></div><% } %>
  <form class="form-card" action="<%= formAction %>" method="post">
    <label for="project_name">Project name</label>
    <input id="project_name" name="project_name" value="<%= project.project_name %>" maxlength="100" required>
    <label for="project_description">Description</label>
    <textarea id="project_description" name="project_description" maxlength="1000" required><%= project.project_description %></textarea>
    <label for="project_location">Location</label>
    <input id="project_location" name="project_location" value="<%= project.project_location %>" maxlength="150" required>
    <label for="project_date">Date</label>
    <input id="project_date" name="project_date" type="date" value="<%= project.project_date.toISOString ? project.project_date.toISOString().slice(0, 10) : project.project_date %>" required>
    <label for="organization_id">Organization</label>
    <select id="organization_id" name="organization_id" required>
      <option value="">Select an organization</option>
      <% organizations.forEach((organization) => { %>
        <option value="<%= organization.organization_id %>" <%= String(project.organization_id) === String(organization.organization_id) ? "selected" : "" %>><%= organization.organization_name %></option>
      <% }) %>
    </select>
    <fieldset>
      <legend>Categories</legend>
      <% categories.forEach((category) => { %>
        <label><input type="checkbox" name="category_ids" value="<%= category.category_id %>" <%= project.category_ids?.includes(category.category_id) ? "checked" : "" %>> <%= category.category_name %></label>
      <% }) %>
    </fieldset>
    <button class="button" type="submit">Save project</button>
    <a class="button button-secondary" href="/projects">Cancel</a>
  </form>
</section>
<%- include("partials/footer") %>