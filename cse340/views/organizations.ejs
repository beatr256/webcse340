<%- include("partials/header") %>

<section class="page-heading">
  <h1>Organizations</h1>
  <p>
    Discover organizations working to improve communities
    through service.
  </p>
</section>

<section class="card-grid organization-grid">

  <article class="card organization-card">
    <img
      src="/images/organization1.jpg"
      alt="Volunteers working together on a community service project"
    >

    <div class="card-content">
      <h2>Community Support Organization</h2>
      <p>
        Supports local communities through volunteer activities
        and service projects.
      </p>
    </div>
  </article>

  <article class="card organization-card">
    <img
      src="/images/organization2.jpg"
      alt="People participating in an educational service activity"
    >

    <div class="card-content">
      <h2>Education for Everyone</h2>
      <p>
        Provides educational support and learning opportunities
        for community members.
      </p>
    </div>
  </article>

  <article class="card organization-card">
    <img
      src="/images/organization3.jpg"
      alt="Volunteers helping people in their community"
    >

    <div class="card-content">
      <h2>Healthy Communities</h2>
      <p>
        Helps communities improve health and wellness through
        service and outreach programs.
      </p>
    </div>
  </article>

</section>

<%- include("partials/footer") %>