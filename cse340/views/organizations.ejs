<%- include("partials/header") %>

<section class="page-heading">
  <h1><%= title %></h1>
  <p>
    Discover organizations working to improve communities
    through service.
  </p>
</section>

<section class="card-grid organization-grid">
  <% organizations.forEach((organization) => { %>
    <article class="card organization-card">
      <img
        src="/images/<%= organization.image_file %>"
        alt="Service activity for <%= organization.organization_name %>"
      >

      <div class="card-content">
        <h2><a href="/organization/<%= organization.organization_id %>"><%= organization.organization_name %></a></h2>
        <p><%= organization.organization_description %></p>
        <p>Contact: <a href="mailto:<%= organization.contact_email %>"><%= organization.contact_email %></a></p>
      </div>
    </article>
  <% }) %>

</section>

<%- include("partials/footer") %>