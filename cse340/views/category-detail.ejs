<%- include("partials/header") %>

<section class="page-heading">
  <h1><%= category.category_name %></h1>
  <p>Service projects in this category.</p>
</section>

<section class="content-section">
  <% if (projects.length) { %>
    <div class="card-grid">
      <% projects.forEach((project) => { %>
        <article class="card">
          <h2><a href="/project/<%= project.project_id %>"><%= project.project_name %></a></h2>
          <p>Organization: <%= project.organization_name %></p>
          <p>Date: <%= new Date(project.project_date).toLocaleDateString() %></p>
        </article>
      <% }) %>
    </div>
  <% } else { %>
    <p>No service projects are currently assigned to this category.</p>
  <% } %>
</section>

<%- include("partials/footer") %>
