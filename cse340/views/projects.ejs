<%- include("partials/header") %>

<section class="page-heading">
  <h1><%= title %></h1>
  <p>
    Find opportunities to serve your community and make a difference.
  </p>
  <a href="/new-project" class="button">Create Service Project</a>
</section>

<section class="card-grid">
  <% projects.forEach((project) => { %>
    <article class="card">
      <h2><a href="/project/<%= project.project_id %>"><%= project.project_name %></a></h2>
      <p><%= project.project_description %></p>
      <p>Organization: <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
      <p>Location: <%= project.project_location %></p>
      <p>Date: <%= new Date(project.project_date).toLocaleDateString() %></p>
      <a href="/edit-project/<%= project.project_id %>">Edit project</a>
    </article>
  <% }) %>

</section>

<%- include("partials/footer") %>