<%- include("partials/header") %>

<section class="page-heading">
  <h1>Log In</h1>
  <p>Access your Service Connect account.</p>
</section>

<section class="form-section">
  <% if (errors.length) { %>
    <ul class="form-errors" role="alert">
      <% errors.forEach((error) => { %><li><%= error %></li><% }) %>
    </ul>
  <% } %>

  <form class="form-card" action="/login" method="post">
    <label for="email">Email</label>
    <input id="email" name="email" type="email" autocomplete="username" value="<%= email %>" required>

    <label for="password">Password</label>
    <input id="password" name="password" type="password" autocomplete="current-password" required>

    <button class="button form-submit" type="submit">Log In</button>
    <p>New to Service Connect? <a href="/register">Create an account</a>.</p>
  </form>
</section>

<%- include("partials/footer") %>