<%- include("partials/header") %>

<section class="page-heading">
  <h1>Create Account</h1>
  <p>Join Service Connect to explore opportunities in your community.</p>
</section>

<section class="form-section">
  <% if (errors.length) { %>
    <ul class="form-errors" role="alert">
      <% errors.forEach((error) => { %><li><%= error %></li><% }) %>
    </ul>
  <% } %>

  <form class="form-card" action="/register" method="post">
    <label for="name">Name</label>
    <input id="name" name="name" type="text" autocomplete="name" maxlength="100" value="<%= name %>" required>

    <label for="email">Email</label>
    <input id="email" name="email" type="email" autocomplete="email" maxlength="255" value="<%= email %>" required>

    <label for="password">Password</label>
    <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="128" required>

    <button class="button form-submit" type="submit">Create Account</button>
    <p>Already registered? <a href="/login">Log in</a>.</p>
  </form>
</section>

<%- include("partials/footer") %>